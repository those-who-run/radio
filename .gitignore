__pycache__/
# Claude Code: only the shared settings, the guard and its config are tracked;
# the rest, among it the worktrees in .claude/worktrees/, stays out.
.claude/*
!.claude/settings.json
!.claude/guard.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/guard.py
# Tracked: the copies of those-who-run/.github's agent/ files that its agent/copies.json lists.
!.claude/agents/
!.claude/skills/
.venv/
.coverage
.mypy_cache/
.pytest_cache/
.ruff_cache/
/voices/
